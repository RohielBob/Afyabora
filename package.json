{
  "name": "glyka",
  "private": true,
  "version": "0.1.0",
  "description": "Glyka — carte numérique d'historique médical pour diabétiques (monorepo)",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev:api": "pnpm --filter @glyka/api dev",
    "dev:portal": "pnpm --filter @glyka/portal dev",
    "dev:mobile": "pnpm --filter @glyka/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db mailpit",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @glyka/api prisma:migrate",
    "db:seed": "pnpm --filter @glyka/scripts seed:demo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "eslint": "^9.12.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml,css}": "prettier --write"
  }
}
