NODE_ENV=development
PORT=3000

# Base de données (docker compose up -d db)
DATABASE_URL=postgresql://glyka:glyka_dev_password@localhost:5432/glyka

# Authentification — générer avec : openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Chiffrement des champs sensibles (AES-256-GCM) — 32 octets en base64 : openssl rand -base64 32
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# Emails (Mailpit en local : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Glyka <no-reply@glyka.local>"

# URLs publiques utilisées dans les emails et les QR
PORTAL_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Modèle de langage (optionnel : sans clé, les gabarits de texte sont utilisés)
LLM_PROVIDER=none
LLM_API_KEY=

# Notifications push (Expo)
EXPO_ACCESS_TOKEN=
