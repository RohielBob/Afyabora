NODE_ENV=development
PORT=3000

# Base de données (docker compose up -d db)
DATABASE_URL=postgresql://glyka:glyka_dev_password@localhost:5432/glyka

# Authentification — OBLIGATOIRE : remplacer par un vrai secret (l'API refuse de démarrer avec la valeur d'exemple).
# Générer : node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Chiffrement des champs sensibles (AES-256-GCM) — OBLIGATOIRE : 32 octets en base64.
# Générer : node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Ne JAMAIS perdre ni partager cette clé : sans elle, les champs chiffrés sont illisibles.
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes

# Emails (Mailpit en local : http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Afyabora <no-reply@afyabora.local>"
# Hébergement (L0-10) : service d'envoi réel (ex. Brevo). Laisser vide avec Mailpit en développement.
SMTP_USER=
SMTP_PASS=
# true = TLS dès la connexion (port 465) ; false = STARTTLS exigé si SMTP_USER est rempli (port 587).
SMTP_SECURE=false

# URLs publiques utilisées dans les emails et les QR
PORTAL_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Nombre de relais (proxys) devant l'API chez l'hébergeur (Render : 1). 0 en local.
TRUST_PROXY_HOPS=0

# Modèle de langage (L3-05, optionnel). none = phrases du moteur seulement (défaut, la démo n'en dépend
# jamais). ollama = modèle LOCAL : installer https://ollama.com puis « ollama pull mistral-nemo ».
# Les phrases envoyées ne contiennent que des faits agrégés ; OLLAMA_URL = un serveur que vous contrôlez.
# Avec ollama, l'assistant (L9-07) met aussi ses réponses en mots : « en préparation », prêtes en 2 min au plus.
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
LLM_MODEL=mistral-nemo
# Temps maximal d'une reformulation en millisecondes (en arrière-plan : l'API ne l'attend jamais).
LLM_TIMEOUT_MS=90000
LLM_API_KEY=

# Notifications push (Expo)
EXPO_ACCESS_TOKEN=

# Données de démonstration (pnpm db:seed) : mot de passe commun des faux comptes de démo.
# À choisir librement, de préférence différent de tout vrai mot de passe.
DEMO_PASSWORD=

# Assistant « Afyabora » (L9-06) : servir aussi les fiches en BROUILLON (pas encore relues par le médecin,
# affichées « Fiche non encore relue ») ? Vide = oui hors production, non en production.
# « true » en production uniquement pour une démonstration.
ASSISTANT_DRAFT_SHEETS=
